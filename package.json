{
  "name": "dsh-pencil",
  "version": "0.1.0",
  "description": "消息编辑铅笔：在助手回复上加铅笔按钮，编辑后从该回合分叉出一个新版本会话，原会话保留",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CREDITS.md",
    "LICENSE",
    "add-bundle.mjs",
    "remove-bundle.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "client-plugin",
    "message-edit",
    "fork",
    "pencil"
  ],
  "author": "YG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Branwen050/dsh-pencil.git"
  },
  "homepage": "https://github.com/Branwen050/dsh-pencil#readme",
  "bugs": {
    "url": "https://github.com/Branwen050/dsh-pencil/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
